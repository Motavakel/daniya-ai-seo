{
    admin off
    auto_https off
}

https://{$GATEWAY_DOMAIN}:8444 {
    tls /etc/caddy/gateway/gateway.fullchain.pem /etc/caddy/gateway/gateway.key

    @enroll {
        method POST
        path /oauth/enroll
    }

    handle @enroll {
        reverse_proxy gateway:3000 {
            header_up -X-Client-Cert-Fingerprint-Sha256
        }
    }

    handle {
        respond "Not Found" 404
    }
}

https://{$GATEWAY_DOMAIN}:443 {
    tls /etc/caddy/gateway/gateway.fullchain.pem /etc/caddy/gateway/gateway.key {
        client_auth {
            mode require_and_verify
            trust_pool file {
                pem_file /etc/caddy/client-ca/ca.cert.pem
            }
        }
    }

    reverse_proxy gateway:3000 {
        header_up -X-Client-Cert-Fingerprint-Sha256
        header_up X-Client-Cert-Fingerprint-Sha256 {http.request.tls.client.fingerprint}
    }
}
